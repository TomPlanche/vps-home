# The TOML file of the services, relative to the folder the server starts in.
# Left empty, it is services.toml. See services.example.toml.
SERVICES_FILE=""

# The tokens of the widgets. services.toml names the variable of each one, with
# `token_env`. Paperless: the API token of a user, from its profile page.
PAPERLESS_TOKEN=""
# Immich: an API key of an admin, with the server.statistics permission.
IMMICH_API_KEY=""
